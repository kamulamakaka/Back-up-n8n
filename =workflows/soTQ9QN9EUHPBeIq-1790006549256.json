    {
      "parameters": {
        "promptType": "define",
        "text": "={{ 'Summarize this order details for the sales team. Tone: ' + $('CONFIG: Thresholds').item.json.aiTone + '.\\n\\nOrder ID: ' + $json.OrderID + '\\nCustomer: ' + $json.CustomerName + '\\nOrder amount: $' + Number(String($json.OrderAmount).replace(/[$,\\s]/g, '')).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 }) + '\\nOrder details: ' + $json.OrderDetails + '\\n\\nClearly state why the order requires Account Manager attention and keep the summary under 120 words.' }}",
        "options": {
          "systemMessage": "You write accurate, professional morning sales briefs. Use only the supplied order data. Do not invent customer, commercial, or delivery details.",
          "maxIterations": 2,
          "enableStreaming": false
        }
      },
