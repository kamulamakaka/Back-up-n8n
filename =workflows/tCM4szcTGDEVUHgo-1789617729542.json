      "position": [
        720,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "// Prepare clean payload for the AI + count\nconst errors = $input.first().json.errors || [];\nconst totalErrors = errors.length;\n\n// Create a readable summary of the errors for the prompt\nconst errorSummary = errors.map((e, i) => {\n  return `${i + 1}. [${e.WorkflowName}] ${e.ErrorMessage} (at ${e.Timestamp})`;\n}).join('\\n');\n\nreturn [{\n  json: {\n    totalErrors,\n    errorSummary,\n    rawErrors: errors\n  }\n}];"
      },
      "id": "66e46ab2-6a78-4ca7-a371-4bcad6c61e06",
      "name": "05_Prepare_AI_Input",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        960,
        0
      ]
    },
    {
      "parameters": {},
      "id": "27a70445-2057-4a72-a1d2-58b9fb90822e",
      "name": "06_AI_Reliability_Analyst",
      "type": "n8n-nodes-base.openAi",
      "typeVersion": 1.8,
      "position": [
        1200,
        0
      ],
      "credentials": {}
    },
    {
      "parameters": {
        "jsCode": "// Parse the AI response and combine with the total error count\nconst aiRaw = $input.first().json.message?.content || $input.first().json.text || $input.first().json;\n\nlet parsed;\ntry {\n  // Clean possible markdown code fences\n  const cleaned = typeof aiRaw === 'string' \n    ? aiRaw.replace(/```json|```/g, '').trim() \n    : JSON.stringify(aiRaw);\n  parsed = JSON.parse(cleaned);\n} catch (e) {\n  // Fallback if AI returns bad JSON\n  parsed = {\n    analysis_summary: \"AI analysis failed to return valid JSON. Please check the raw logs.\",\n    top_workflow: \"Unknown\",\n    priority_action: \"Manually review the DailySummaries sheet and the original logs.\"\n  };\n}\n\nconst totalErrors = $('05_Prepare_AI_Input').first().json.totalErrors;\n\nreturn [{\n  json: {\n    Date: new Date().toISOString(),\n    TotalErrors: totalErrors,\n    AI_Analysis: parsed.analysis_summary || \"\",\n    Top_Failing_Workflow: parsed.top_workflow || \"Unknown\",\n    priority_action: parsed.priority_action || \"\",\n    analysis_summary: parsed.analysis_summary || \"\",\n    top_workflow: parsed.top_workflow || \"Unknown\"\n  }\n}];"
      },
      "id": "9529b9d8-5133-4466-982b-0b65f60de6eb",
      "name": "07_Parse_AI_Response",
      "type": "n8n-nodes-base.code",
