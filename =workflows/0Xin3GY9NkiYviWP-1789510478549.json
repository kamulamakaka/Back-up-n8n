    {
      "parameters": {
        "promptType": "define",
        "text": "=Analyze the technical logs below:\n\n{{ $json[\"Raw Logs\"] }}\n\nIncident metadata:\nIncident ID: {{ $json[\"Incident ID\"] }}\nTimestamp: {{ $json[\"Timestamp\"] }}\n\nTasks:\n1. Draft a professional post-mortem summary in clear plain text. Use these section headings: Executive Summary, Customer and Business Impact, Timeline and Evidence, Root Cause, Resolution and Recovery, and Corrective and Preventive Actions. Do not invent facts; write \"Unknown from provided logs\" where evidence is missing.\n2. Determine severity using this rubric:\n- High: core production service unavailable, widespread customer impact, confirmed or likely data loss, security breach, or a major incident requiring immediate executive attention.\n- Medium: meaningful service degradation or limited customer impact, but no evidence of a critical outage, security breach, or data loss.\n- Low: minor, isolated, transient, or informational issue with negligible customer impact.\n3. Create a concise incident title.\n\nReturn JSON only with report_body, severity_score, and incident_title.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are an experienced Site Reliability Incident Commander. Base every conclusion only on the supplied logs. Apply the severity rubric consistently so that only genuinely critical incidents are classified High.",
          "maxIterations": 3,
          "enableStreaming": false
        }
      },
      "id": "afdbdcd8-b576-4d97-b050-b8b4474d724c",
      "name": "Incident Commander",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        -720,
        -176
      ]
    },
    {
      "parameters": {
        "schemaType": "manual",
        "inputSchema": "{\n  \"type\": \"object\",\n  \"properties\": {\n    \"report_body\": {\n      \"type\": \"string\",\n      \"description\": \"Professional post-mortem report in plain text\"\n    },\n    \"severity_score\": {\n      \"type\": \"string\",\n      \"enum\": [\"High\", \"Medium\", \"Low\"]\n    },\n    \"incident_title\": {\n      \"type\": \"string\",\n      \"description\": \"Concise professional incident title\"\n    }\n  },\n  \"required\": [\"report_body\", \"severity_score\", \"incident_title\"],\n  \"additionalProperties\": false\n}"
      },
      "id": "786c9c9c-23ab-4699-a948-f097525b0e97",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
