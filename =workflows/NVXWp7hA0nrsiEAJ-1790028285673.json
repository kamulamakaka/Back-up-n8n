    {
      "parameters": {
        "promptType": "define",
        "text": "=Review these workflow error logs from the last 24 hours:\n{{ JSON.stringify($json.errors, null, 2) }}\n\n1. Identify the workflow causing the most errors.\n2. Summarize the most likely root causes, grouping related technical symptoms.\n3. Recommend one priority action for the reliability team.\n\nReturn only the structured JSON requested by the connected output parser.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are a senior reliability analyst. Be concise, evidence-based, and operational. Do not invent causes that are unsupported by the supplied error messages."
        }
      },
      "id": "f265b884-5496-4339-95e9-855fe521f212",
      "name": "AI Reliability Analyst",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 3.1,
      "position": [
        1056,
        -48
      ]
    },
    {
      "parameters": {
        "jsonSchemaExample": "{\n  \"analysis_summary\": \"Inventory_Sync errors are dominated by repeated API or database timeouts.\",\n  \"top_workflow\": \"Inventory_Sync\",\n  \"priority_action\": \"Inspect Inventory API and warehouse database connectivity, authentication, and timeout thresholds.\"\n}"
      },
      "id": "3b04bed0-725d-4fe5-91d1-7cd61082098f",
      "name": "Structured Output Parser",
      "type": "@n8n/n8n-nodes-langchain.outputParserStructured",
      "typeVersion": 1.3,
      "position": [
        1232,
        400
      ]
    },
    {
      "parameters": {
        "jsCode": "const raw = $json.output ?? $json;\nlet parsed = raw;\n\nif (typeof raw === 'string') {\n  const cleaned = raw\n    .replace(/^```(?:json)?\\s*/i, '')\n    .replace(/\\s*```$/, '')\n    .trim();\n  parsed = JSON.parse(cleaned);\n}\n\nconst errors = $('Aggregate Errors').first().json.errors ?? [];\n\nreturn [{\n  json: {\n    TotalErrors: errors.length,\n    analysis_summary: parsed.analysis_summary ?? 'No analysis returned',\n    top_workflow: parsed.top_workflow ?? 'Unknown',\n    priority_action: parsed.priority_action ?? 'Review the failed workflow logs'\n  }\n}];"
      },
