    {
      "parameters": {
        "promptType": "define",
        "text": "=Current ticket:\n{{ JSON.stringify($json) }}\n\nAll tickets in this webhook batch:\n{{ JSON.stringify($('Read New Support Tickets').all().map(item => item.json)) }}\n\nClean the current ticket.\n1. Standardize Category to exactly one of: Billing, Technical, General. Use the Issue text as the main evidence when the raw Category is unclear.\n2. Decide whether the current ticket is a duplicate. A duplicate must describe the same underlying issue for the same customer email as another ticket in this batch. Keep the earliest TicketID and mark only the later matching ticket as duplicate. Similar issues from different customers are not duplicates.\n\nReturn only the structured output requested by the parser.",
        "hasOutputParser": true,
        "options": {
          "systemMessage": "You are the Janitor stage of a support-ticket workflow. Clean categories conservatively and identify true duplicates without losing distinct customer issues."
        }
      },
      "id": "fa57c53a-bc56-48c3-ad99-16008987999f",
      "name": "AI Agent 1 - Janitor",
      "type": "@n8n/n8n-nodes-langchain.agent",
      "typeVersion": 1.7,
      "position": [
        448,
        144
      ]
    },
    {
      "parameters": {
