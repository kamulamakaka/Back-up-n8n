    {
      "parameters": {
        "jsCode": "const stories = [];\\nfor (const item of $input.all()) {\\n  let value = item.json.output ?? item.json;\\n  if (typeof value === 'string') {\\n    const cleaned = value.replace(/```(?:json)?/gi, '').trim();\\n    try { value = JSON.parse(cleaned); } catch { continue; }\\n  }\\n  if (value?.source && value?.headline) stories.push({ source: value.source, headline: value.headline });\\n}\\nreturn [{ json: { stories, successfulSources: stories.length + '/5 sources' } }];"
      },
